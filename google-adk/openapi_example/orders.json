{
  "openapi": "3.0.0",
  "info": {
    "title": "本地订单服务（教学示例）",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9"
    }
  ],
  "paths": {
    "/orders/{order_id}": {
      "get": {
        "operationId": "get_order",
        "summary": "查询订单状态",
        "description": "按订单号查询状态。本示例只用于演示工具发现，不发起真实请求。",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "订单号，例如 A100",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
